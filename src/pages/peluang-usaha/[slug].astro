---
// Deprecated brand-detail path, fallback only.
//
// Franchisor.id brand pages live at /usaha/{slug} (see docs/data/SHARED_DATA_CONTRACT.md).
// functions/peluang-usaha/[slug].js is the primary handler: it answers with a real HTTP 301
// when the shared D1 database confirms a published Franchisor projection for the slug. This
// route is the fallback for a request the Function deliberately lets through — for example a
// D1 lookup failure — and it consolidates with canonical plus noindex rather than serving a
// competing duplicate. Directory, category, city and capital hub routes under
// /peluang-usaha/ are unaffected and remain their own pages.
import { loadFranchiseStaticRows } from "../../lib/franchise-static";

export const prerender = true;

export function getStaticPaths() {
  return loadFranchiseStaticRows().map((row) => ({
    params: { slug: row.slug },
    props: { canonicalPath: `/usaha/${row.slug}` },
  }));
}

const { canonicalPath } = Astro.props as { canonicalPath: string };
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <title>Halaman dipindahkan</title>
    <link rel="canonical" href={canonicalPath} />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${canonicalPath}`} />
  </head>
  <body>
    <p>Halaman brand ini pindah ke <a href={canonicalPath}>{canonicalPath}</a>.</p>
  </body>
</html>
